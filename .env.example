# ── 数据库（必需）──
# PostgreSQL 连接串。本地开发可用 `docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logup"

# ── GitHub API（强烈建议）──
# 用于爬取 releases/tags/trending，提高 API 速率限制（创建一次 GH_TOKEN 即可）
GITHUB_TOKEN=""

# ── 翻译服务（可选，/api/translate 需要）──
# 硅基流动的 API Key（当前 /api/translate 使用 siliconflow.cn 的 Hunyuan-MT-7B 模型）
NVIDIA_API_KEY=""

# ── 站点 URL（sitemap / 运营脚本使用）──
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── 运营管道（可选）──
# 中文社区搜索服务（github-data-ops 运营时用于补全 links）
DDGS_SEARCH_API=""

# ── 工业抓取引擎（可选，scripts/crawler.js）──
# 代理池，逗号分隔多个（http/socks 均可）：轮询轮换，403/429 自动切换重试
PROXY_URLS="http://user:pass@host:port,http://user:pass@host2:port"
# 是否遵守 robots.txt
CRAWLER_RESPECT_ROBOTS=false
# 每域名最小请求间隔（毫秒，含随机抖动）
CRAWLER_MIN_DELAY_MS=1200
# 全局并发上限
CRAWLER_MAX_CONCURRENCY=5
# 失败重试次数
CRAWLER_RETRIES=3
# 请求超时（毫秒）
CRAWLER_TIMEOUT_MS=15000

# ── GitHub 多 token 轮换（可选，提高限流上限）──
GITHUB_TOKEN_2=""
GITHUB_TOKEN_3=""

# ── GitHub Actions 后台控制（可选，/api/ops/gh-actions）──
# 带 workflow 权限的 PAT，用于后台派发/取消 GH Actions 流水线
GH_DISPATCH_TOKEN=""
# 目标仓库
GITHUB_REPO="kisrea-team/LogUp"

# ── Google Indexing API（可选，SEO）──
GOOGLE_SA_JSON=""

# ── 安全（可选）──
# admin 登录的会话密钥（见 app/api/auth 相关路由）。留空则使用开发默认值
ADMIN_SESSION_SECRET="change-me-in-production"

# ── Prisma Studio ──
# 直接使用上面的 DATABASE_URL 即可
