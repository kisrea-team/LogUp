{
    "kind": "collectionType",
    "collectionName": "versions",
    "info": {
        "singularName": "version",
        "pluralName": "versions",
        "displayName": "Version"
    },
    "options": {
        "draftAndPublish": false
    },
    "attributes": {
        "project": {
            "type": "relation",
