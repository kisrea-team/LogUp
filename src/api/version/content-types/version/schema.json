            "target": "api::project.project",
            "inversedBy": "versions"
        },
        "version": {
            "type": "string",
            "required": true
        },
        "update_time": {
            "type": "date",
            "required": true
        },
        "content": {
            "type": "text",
            "required": true
        },
        "download_url": {
            "type": "string",
            "required": true
        }
    }
}